{
  "name": "win7-agent-gateway",
  "version": "0.1.0",
  "description": "Model Gateway for Win7 Coding Agent — versioned streaming protocol client for remote model inference",
  "private": true,
  "engines": {
    "node": ">=16.17.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --forceExit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "@types/node": "^16.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts"]
  }
}
